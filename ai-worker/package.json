{
  "name": "@creatoros/ai-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./model-identity": {
      "types": "./src/runtime/provider-identity.ts",
      "default": "./src/runtime/provider-identity.ts"
    },
    "./retry-policy": {
      "types": "./src/runtime/retry-policy.ts",
      "default": "./src/runtime/retry-policy.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./durable-generation": {
      "types": "./src/execution/durable-generation-model.ts",
      "default": "./src/execution/durable-generation-model.ts"
    },
    "./agentic-runtime": {
      "types": "./src/runtime/agentic/index.ts",
      "default": "./src/runtime/agentic/index.ts"
    },
    "./durable-agentic-tool": {
      "types": "./src/execution/durable-agentic-tool.ts",
      "default": "./src/execution/durable-agentic-tool.ts"
    },
    "./durable-pi-stream": {
      "types": "./src/execution/durable-pi-stream.ts",
      "default": "./src/execution/durable-pi-stream.ts"
    },
    "./agentic-run": {
      "types": "./src/execution/agentic-worker-run.ts",
      "default": "./src/execution/agentic-worker-run.ts"
    },
    "./browser": {
      "types": "./src/runtime/browser/index.ts",
      "default": "./src/runtime/browser/index.ts"
    },
    "./browser/*": {
      "types": "./src/runtime/browser/*.ts",
      "default": "./src/runtime/browser/*.ts"
    },
    "./durable-stream": {
      "types": "./src/execution/durable-stream-model.ts",
      "default": "./src/execution/durable-stream-model.ts"
    },
    "./chat": {
      "types": "./src/runtime/chat/index.ts",
      "default": "./src/runtime/chat/index.ts"
    },
    "./chat-worker-run": {
      "types": "./src/execution/chat-worker-run.ts",
      "default": "./src/execution/chat-worker-run.ts"
    },
    "./asr-identity": {
      "types": "./src/runtime/asr-execution-identity.ts",
      "default": "./src/runtime/asr-execution-identity.ts"
    },
    "./asr-transcript": {
      "types": "./src/runtime/asr-transcript.ts",
      "default": "./src/runtime/asr-transcript.ts"
    },
    "./douyin-transcribe-source": {
      "types": "./src/runtime/douyin-transcribe-source.ts",
      "default": "./src/runtime/douyin-transcribe-source.ts"
    },
    "./douyin-transcribe-detail": {
      "types": "./src/runtime/douyin-transcribe-detail.ts",
      "default": "./src/runtime/douyin-transcribe-detail.ts"
    },
    "./douyin-errors": {
      "types": "./src/runtime/douyin-errors.ts",
      "default": "./src/runtime/douyin-errors.ts"
    },
    "./transcript-postprocess": {
      "types": "./src/runtime/transcript-postprocess.ts",
      "default": "./src/runtime/transcript-postprocess.ts"
    },
    "./cover": {
      "types": "./src/runtime/cover-plan.ts",
      "default": "./src/runtime/cover-plan.ts"
    },
    "./video-decisions-runner": {
      "types": "./src/runtime/video-decisions-runner.ts",
      "default": "./src/runtime/video-decisions-runner.ts"
    },
    "./srt": {
      "types": "./src/runtime/srt.ts",
      "default": "./src/runtime/srt.ts"
    },
    "./chunk-and-merge": {
      "types": "./src/runtime/chunk-and-merge.ts",
      "default": "./src/runtime/chunk-and-merge.ts"
    },
    "./error-diagnostics": {
      "types": "./src/runtime/error-diagnostics.ts",
      "default": "./src/runtime/error-diagnostics.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.1",
    "@ai-sdk/deepseek": "^3.0.1",
    "@ai-sdk/openai": "^4.0.2",
    "@ai-sdk/openai-compatible": "^3.0.1",
    "@anthropic-ai/claude-agent-sdk": "^0.3.185",
    "@xenova/transformers": "^2.17.2",
    "ai": "^7.0.4",
    "ajv": "^8.20.0",
    "zod": "^4.4.3",
    "@creatoros/contract": "workspace:*",
    "@earendil-works/pi-ai": "0.80.7",
    "@earendil-works/pi-coding-agent": "0.80.7",
    "@playwright/test": "1.60.0",
    "@mozilla/readability": "0.6.0",
    "jsdom": "29.1.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.0",
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vitest": "4.1.8",
    "esbuild": "0.28.1",
    "@types/jsdom": "28.0.3"
  }
}
