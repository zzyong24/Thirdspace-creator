 const roots=await card.locator('[data-slot="echart"]').count();if(!roots)return {canvasCount:0,samples:0,stableForMs:0};
 await expect.poll(()=>card.locator('canvas').count(),{timeout:120000}).toBeGreaterThanOrEqual(roots);
 let previous='',changedAt=Date.now(),samples=0,canvasCount=0;
 await expect.poll(async()=>{const pixels=await card.locator('canvas').evaluateAll(nodes=>nodes.map(node=>(node as HTMLCanvasElement).toDataURL()));canvasCount=pixels.length;const next=pixels.join('|');samples++;if(next!==previous){previous=next;changedAt=Date.now();}return Date.now()-changedAt>=250;},{timeout:120000,intervals:[100,100,250]}).toBe(true);
