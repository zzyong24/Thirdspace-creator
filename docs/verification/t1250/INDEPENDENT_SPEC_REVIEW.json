  "observations": [
    {
      "id": "R1250-DEADLINE",
      "source": "frontend/src/server/ingestion/douyin-cdp-comment-diagnosis.ts:194,203,240,322-354",
      "observation": "原300s life在start生成；idle90s原touch在active step起点重挂会误中止，inspect/observe分别1s竞速，checkout5s/goto15s/click5s为正执行；SPEC保life/idle数值，用更早原deadline和共享观察期限闭包，不续期。",
      "contract": "FR-1250-DEADLINE、AC-1250-CDP"
    },
    {
      "id": "R1250-SERIAL",
      "source": "frontend/src/server/workbench-artifact-render.ts:65-123；frontend/src/server/workbench-browser-host.ts:162-190",
      "observation": "render setup/launch/goto/output/真实close目录清理串行；PDF within20s亦为漏扫；恢复两mode lookup再cleanup与DB fresh-check，不可用单次120s当外层；SPEC明确实际槽求和和独立清理余量。",
      "contract": "FR-1250-EXEC、AC-1250-RENDER/RECOVER"
    },
    {
      "id": "R1250-STOP",
      "source": "frontend/src-tauri/src/workbench/browser.rs:799-845,894-940；frontend/src/server/workbench-browser-host.ts:182-190",
      "observation": "cleanup确实执行cleanup_bound_owner_lanes后stop_proof；原proof同时核bound scope/原profile lease、inflight、hub lanes/hosts/pending、OS无进程。SPEC不延admission TTL、不改proof布尔逻辑，不以断连接替停止。",
      "contract": "FR-1250-BOUNDARY、AC-1250-RECOVER"
    },
    {
      "id": "R1250-SIGNAL",
      "source": "frontend/src/server/workbench-native-client.ts:41-95,161-170；frontend/src/server/workbench-native-host.ts:136-185；frontend/src/server/workbench-artifact-host.ts:83-94；backend/src/modules/execution/workbench-file-recovery.service.ts:92-112",
      "observation": "原native send只socket10s活动计时、没有signal；host只前后check，artifact分页回调也未带signal；readReceipt发生在DB事务外已有control检查但未将signal送入read port。SPEC只沿私有参数改这些原端口，派发后unknown与原named receipt保持，不write retry。",
      "contract": "FR-1250-CANCEL、AC-1250-NATIVE"
    },
    {
      "id": "R1250-IPC",
      "source": "frontend/src-tauri/src/workbench/ipc.rs:313-331；ipc_windows.rs:52,367-434；browser_ipc.rs:70-122",
      "observation": "真实mac读写10s、Windows每块IO10s、browser读10s写120s；活动计时/partial bytes可续单块计时，不能代签墙钟；SPEC要求冻结本次观察期限或完整独立outer、保peer/ACL/大小限制及CancelIoEx栈回收。必须以实际实现证明取消与收尾，不由本静态审签测试。",
      "contract": "FR-1250-EXEC/DEADLINE/CANCEL、AC-1250-NATIVE"
    },
    {
      "id": "R1250-VENDOR",
      "source": "原22绑定的5个冻结vendor文件/10命中；tools/timeout-policy/check.mjs:11-23,44-58",
      "observation": "实际读取证明3 requestIdleCallback max调度等待、6已明确UI关闭后destroy/unmount、Axios38974 timeout:y绑定邻近function y合并策略不是数字。扫描器当前全文件Map忽略scope。SPEC限真实API/词法绑定与已证明消费者，保未知/短正执行反例，无路径豁免或vendor改写。",
      "contract": "FR-1250-CLASSIFY、AC-1250-SCAN"
    },
    {
      "id": "R1250-TYPES",
      "source": "docs/verification/t1246/round-2/unit/frontend-standard-types-attempt2.txt / -exit.json / -binding.json",
      "observation": "实际未裁剪standard tsc exit2：T1062 document三错和T1070 resolve一错，共两文件四错。最新SPEC明确保首轮100输入，不删改排除；必须完整真实非零回执并证新增错误0与四处SHA首轮一致后，才按范围外规则说明，不签全局types或T1246全验。",
      "contract": "AC-1250-GATE"
    }
  ],
