import assert from 'node:assert/strict';
import {createChatSkillLibrary} from '../../backend/src/modules/ai-runtime/chat-skill-library.ts';
import {buildChatTools} from '../../backend/src/modules/ai-runtime/chat-tools.ts';
import {prepareChatToolDefinitions} from '../../backend/src/modules/ai-runtime/chat-tool-definitions.ts';
import {getChatToolNativeExecutor} from '../../backend/src/modules/ai-runtime/chat-tool-gate.ts';
import {createChatReadToolResolver} from '../../backend/src/modules/ai-runtime/chat-read-tool-resolver.ts';
import {pageChatToolResult} from '../../backend/src/modules/ai/chat-tool-result-page.ts';
const ctx:any={userId:'u',accountId:'a'};const ref:any={taskId:'task',leaseToken:'lease',attempt:1};
const snapshot:any={snapshotVersion:1,...ctx,resolvedAt:'test',platformPolicyVersion:'1',platformPolicy:'test',skills:[{skillId:'method.research',baseVersion:'1',overlayRevision:null,overlayVersion:null,effective:{methodSystem:'冻结研究方法',template:'',tools:[],requiredFacets:[],contextRequirements:[],outputSchema:null,completionPolicy:null,completionPolicyAdapter:null}}]};
const initial=buildChatTools(['skill.read','history.read','tool.result.read'],{skillLibrary:createChatSkillLibrary(snapshot,ctx)} as any);
const definitions=(await prepareChatToolDefinitions(initial)).definitions;
let portCalls=0;
const resolver=createChatReadToolResolver({read:async()=>({context:ctx,hostContext:{skillSnapshot:snapshot,chatContext:{surface:'project'}},modelInput:{tools:definitions,messages:[{role:'user',content:'冻结用户原文'}]}} as any),readToolResult:async(r:any,input:any)=>{assert.equal(r.taskId,'task');portCalls++;return pageChatToolResult(input.toolCallId,{text:'已结算原结果'},input.offset);}} as any,{});
const tools=await resolver(ctx,ref);
const a:any=await getChatToolNativeExecutor(tools['skill.read']!)!({skillId:'method.research'},{});assert.equal(a.text,'冻结研究方法');
const b:any=await getChatToolNativeExecutor(tools['history.read']!)!({messageIndex:0},{});assert.match(b.text,/冻结用户原文/);
const c:any=await getChatToolNativeExecutor(tools['tool.result.read']!)!({toolCallId:'call'},{});assert.match(c.text,/已结算原结果/);assert.equal(portCalls,1);
await assert.rejects(()=>resolver({...ctx,accountId:'different'},ref));
console.log('PASS restored frozen definitions -> native skill/history/result read, scoped port, cross-account rejection');
