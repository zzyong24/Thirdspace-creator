+import assert from 'node:assert/strict'
+import crypto from 'node:crypto'
+import fs from 'node:fs'
+import path from 'node:path'
+import { pathToFileURL, fileURLToPath } from 'node:url'
+
+const BASE = '/reference-editors/doocs-md/'
+export function inspectStaticResourceSyntax(program, file, localReference) {
+  const checked = []
+function staticString(node) {
+  if (node?.type === 'Literal' && typeof node.value === 'string') return node.value
+  if (node?.type === 'TemplateLiteral' && node.expressions.length === 0 && node.quasis.length === 1) return node.quasis[0].value.cooked ?? node.quasis[0].value.raw
+  return null
+}
+function viteBasePrefix(node, ancestors) {
+  const addition = ancestors.at(-1)
+  if (addition?.type !== 'BinaryExpression' || addition.operator !== '+' || addition.left !== node || addition.right?.type !== 'Identifier') return false
+  const enclosing = ancestors.findLast(parent => ['FunctionExpression', 'FunctionDeclaration', 'ArrowFunctionExpression'].includes(parent.type))
+  if (!enclosing?.params.some(param => param.type === 'Identifier' && param.name === addition.right.name)) return false
+  return enclosing.body === addition || ancestors.at(-2)?.type === 'ReturnStatement'
+}
+function unwrapParenthesized(node) {
+  const seen = new Set()
+  while (node?.type === 'ParenthesizedExpression') {
+    assert.equal(seen.has(node), false, '括号节点不可形成循环')
+    seen.add(node)
+    assert.ok(node.expression && typeof node.expression.type === 'string', '真实OXC括号节点须有expression')
+    node = node.expression
+  }
+  return node
+}
+// SEMANTIC_BOUNDARY_ALLOW: 只判已观察的pathname membership AST协议，不选择内容或放宽资源文件归属。
+function hostPathnameMembership(node, ancestors) {
+  const call = ancestors.findLast(parent => parent.type === 'CallExpression')
+  if (!call || call.arguments.length !== 1 || unwrapParenthesized(call.arguments[0]) !== node) return false
+  const member = (value, property) => value?.type === 'MemberExpression' && value.computed === false && value.property?.type === 'Identifier' && value.property.name === property
+  const callee = unwrapParenthesized(call.callee)
+  if (!member(callee, 'includes')) return false
+  const pathname = unwrapParenthesized(callee.object)
+  if (!member(pathname, 'pathname')) return false
+  const location = unwrapParenthesized(pathname.object)
+  if (!member(location, 'location')) return false
+  const windowObject = unwrapParenthesized(location.object)
+  return windowObject?.type === 'Identifier' && windowObject.name === 'window'
+}
+function vitePreloadTable(node, file) {
+  if (node.type !== 'VariableDeclarator' || node.id?.type !== 'Identifier' || node.id.name !== '__vite__mapDeps') return
+  const fn = node.init
+  assert.equal(fn?.type, 'ArrowFunctionExpression', '真实Vite依赖表函数结构')
+  const cacheParam = fn.params[1]
+  const tableParam = fn.params[2]
+  assert.ok(cacheParam?.type === 'AssignmentPattern' && cacheParam.left?.type === 'Identifier' && cacheParam.right?.type === 'Identifier' && cacheParam.right.name === '__vite__mapDeps')
+  const cacheName = cacheParam.left.name
+  assert.equal(tableParam?.type, 'AssignmentPattern')
+  const reuse = unwrapParenthesized(tableParam.right)
+  assert.ok(reuse?.type === 'LogicalExpression' && reuse.operator === '||')
+  const assignment = unwrapParenthesized(reuse.right)
+  assert.ok(assignment?.type === 'AssignmentExpression' && assignment.operator === '=' && assignment.left?.type === 'MemberExpression' && assignment.left.object?.type === 'Identifier' && assignment.left.object.name === cacheName)
+  assert.equal(assignment.right?.type, 'ArrayExpression')
+  for (const entry of assignment.right.elements) {
+    const dependency = staticString(entry)
+    assert.ok(dependency, '真实默认renderBuiltUrl=false依赖表须逐项静态可核')
+    localReference(dependency.startsWith(BASE) ? dependency : BASE + dependency, file, 'vite-preload-table')
+  }
+}
+function visit(node, file, ancestors = []) {
+  if (!node || typeof node !== 'object') return
+  vitePreloadTable(node, file)
+  if (node.type === 'ImportDeclaration' || node.type === 'ExportNamedDeclaration' || node.type === 'ExportAllDeclaration' || node.type === 'ImportExpression') {
+    const reference = staticString(node.source)
+    if (reference !== null) localReference(reference, file, 'js-import')
+  }
+  // Vite 的依赖表和资源 URL 是实际 local base Literal；库中的说明文字不算资源。
+  const literal = staticString(node)
+  if (literal?.startsWith(BASE)) {
+    if (literal === BASE && viteBasePrefix(node, ancestors)) checked.push({ kind: 'vite-preload-base-prefix', from: file, reference: literal, notAFile: true, parameterConcatConfirmed: true })
+    else if (literal === BASE && hostPathnameMembership(node, ancestors)) checked.push({ kind: 'host-pathname-membership-prefix', from: file, reference: literal, notAFile: true, exactWindowLocationPathnameIncludesArgument: true })
+    else localReference(literal, file, 'js-base-resource')
+  }
+  for (const value of Object.values(node)) {
+    if (Array.isArray(value)) value.forEach(child => visit(child, file, [...ancestors, node]))
+    else if (value && typeof value === 'object') visit(value, file, [...ancestors, node])
+  }
+}
+  visit(program, file)
+  return { basePrefixes: checked }
+}
+
+async function main(args) {
+const [sourceRoot, originalEntry, deliveryRoot, reportPath] = args
+assert.ok(sourceRoot && originalEntry && deliveryRoot && reportPath)
