-async function compressImage(file: File) {
-  const { default: imageCompression } = await import(`browser-image-compression`)
-  const options = {
-    maxSizeMB: 1,
-    maxWidthOrHeight: 1920,
-    useWebWorker: true,
-  }
-  return await imageCompression(file, options)
-}
