      "before": "it('T1062 空组Moments模型生成冻结NULL账号，切平台过滤共享候选，原lease结算不重签',async()=>{const group:RequestContext={userId:'moments-model-user',accountId:null,groupId:'moments-model-empty',groupVersion:1,source:'user',requestId:'group-model'};const f=await fixture(group);try{const a=await settled(f);expect(await f.service.getCandidate({...group,accountId:'page-filter'},a.candidate.candidateId)).toMatchObject({taskId:a.task.id});const [row]=await f.db.select().from(momentsCandidates);expect(row).toMatchObject({groupId:group.groupId,accountId:null});const [task]=await f.db.select().from(executionTasks);expect(task).toMatchObject({groupId:group.groupId,accountId:null});await a.executor.commitResult(a.ref,a.input);expect((await f.service.getCandidate(group,a.candidate.candidateId)).status).toBe('succeeded');await expect(f.service.getCandidate({...group,groupId:'other-group'},a.candidate.candidateId)).rejects.toThrow();}finally{await f.opened.client.close();}},30000);",
      "after": "it('T1062 空组Moments模型生成冻结NULL账号，切平台过滤共享候选，原lease结算不重签',async()=>{const group:RequestContext={userId:'moments-model-user',accountId:null,groupId:'moments-model-empty',groupVersion:1,source:'user',requestId:'group-model'};const f=await fixture(group);try{const a=await settled(f);expect(await f.service.getCandidate({...group,accountId:'page-filter'},a.candidate.candidateId)).toMatchObject({taskId:a.task.id});const [row]=await f.db.select().from(momentsCandidates);expect(row).toMatchObject({groupId:group.groupId,accountId:null});const [task]=await f.db.select().from(executionTasks);expect(task).toMatchObject({groupId:group.groupId,accountId:null});await a.executor.commitResult(a.ref,a.input);expect((await f.service.getCandidate(group,a.candidate.candidateId)).status).toBe('succeeded');await expect(f.service.getCandidate({...group,groupId:'other-group'},a.candidate.candidateId)).rejects.toThrow();}finally{await f.opened.client.close();}},180000);",
