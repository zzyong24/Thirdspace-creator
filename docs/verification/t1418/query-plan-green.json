      "query": "WITH scoped_works AS (SELECT w.* FROM platform_works w INNER JOIN platform_catalogs c ON c.account_id=w.account_id AND c.user_id=w.user_id AND c.platform=w.platform\n      WHERE w.user_id=$1 AND w.account_id IN ($2)\n      AND w.catalog_generation=c.generation AND (\n        (w.visibility='public' AND w.outbound_frozen_at IS NULL AND w.uncertain_visibility_at IS NULL)\n        OR (w.visibility='unknown' AND c.generation>0 AND c.completed_at IS NOT NULL\n          AND NOT EXISTS (SELECT 1 FROM platform_visibility_tombstones t\n            WHERE t.user_id=w.user_id AND t.account_id=w.account_id AND t.platform=w.platform AND t.external_id=w.external_id))\n      )\n      AND w.published_at IS NOT NULL AND w.published_at::timestamptz>=$3::timestamptz AND w.published_at::timestamptz<$4::timestamptz)\n      SELECT w.id,w.account_id AS \"accountId\",w.platform,w.publication_id AS \"publicationId\",w.legacy_publication_id AS \"legacyPublicationId\",\n        ownership.\"hasOwned\",ownership.\"hasUnattributed\"\n      FROM scoped_works w CROSS JOIN LATERAL (\n        SELECT coalesce(bool_or((true AND (CASE WHEN (m.account_id=$5 AND m.ingested_at>=$6 ) THEN 1 ELSE 0 END)=1 AND ((m.account_id=$7 AND m.ingested_at>=$8 )))) FILTER (WHERE m.id IS NOT NULL),false) AS \"hasOwned\",\n          (count(m.id)=0 OR coalesce(bool_or((NOT true OR (CASE WHEN (m.account_id=$9 AND m.ingested_at>=$10 ) THEN 1 ELSE 0 END)<>1)) FILTER (WHERE m.id IS NOT NULL),false)) AS \"hasUnattributed\"\n        FROM platform_work_metric_snapshots m\n        WHERE m.user_id=$11 AND m.account_id=w.account_id AND m.platform_work_id=w.id AND m.platform=w.platform\n      ) ownership",
