        "success",
        "contractVersion",
        "correlationId",
        "idempotent",
        "data"
      ],
      "dataKeys": [
        "providerKey",
        "providerContractVersion",
        "runtimeSnapshotContractVersion",
        "signedRuntimePayloadVersion",
        "capabilities",
        "licenseModes",
        "authProfile",
        "maxTimestampSkewSeconds",
        "channelConfigAuthorityMode",
        "legacyChannelWritesEnabled",
        "entitlementDeliveryContractVersion",
        "entitlementDeliveryModes",
        "claimConsumePath",
        "claimTtlSeconds"
      ],
      "additiveDataKeys": [
        "entitlementDeliveryContractVersion",
        "entitlementDeliveryModes",
        "claimConsumePath",
        "claimTtlSeconds"
      ],
      "capability": "order_bound_entitlement_claim_v1"
    },
    "provision": {
      "method": "POST",
      "path": "/api/integrations/growth/v1/entitlement-deliveries/provision",
