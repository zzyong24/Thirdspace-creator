{
  "contractVersion": "growth-entitlement-delivery-v1",
  "wireOwner": "activation-manager",
  "sourceSystem": "thirdspace-growth",
  "deliveryModes": [
    "activation_claim"
  ],
  "growthAuthProfile": "am-hmac-v1",
  "creatorResponseAuthProfile": "license-ed25519-v1",
  "claimTtlSeconds": {
    "minimum": 300,
    "maximum": 1800,
    "fixture": 900
  },
  "endpoints": {
    "capabilities": {
      "method": "GET",
