  "item": {
    "id": "archive-understanding",
    "domain": "知识管理",
    "title": "保存不等于理解",
    "lines": [
      {
        "index": 1,
        "startSec": 0,
        "endSec": 4,
        "text": "资料全部进了档案库，不代表它们已经变成你的判断。"
      },
      {
        "index": 2,
        "startSec": 4,
        "endSec": 8,
        "text": "保存解决的是记录，理解需要建立连接。"
      },
      {
        "index": 3,
        "startSec": 8,
        "endSec": 12,
        "text": "让一条新资料连接旧结论，再决定它改变了什么。"
      }
    ],
    "script": "资料全部进了档案库，不代表它们已经变成你的判断。保存解决的是记录，理解需要建立连接。让一条新资料连接旧结论，再决定它改变了什么。"
  },
