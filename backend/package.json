{
  "name": "@creatoros/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./modules/*": {
      "types": "./src/modules/*/index.ts",
      "default": "./src/modules/*/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backfill:transcripts": "tsx scripts/backfill-transcripts.ts",
    "backfill:pub-titles": "tsx scripts/backfill-publication-titles.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@creatoros/contract": "workspace:*",
    "@electric-sql/pglite": "^0.2.0",
    "drizzle-orm": "^0.36.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
