+  imageSourceCache.clear();
+  for (const source of imageSources) {
+    if (source instanceof HTMLImageElement) {
+      source.onload = null;
+      source.onerror = null;
+      source.removeAttribute("src");
+      source.remove();
+    } else {
+      source.width = 1;
+      source.height = 1;
+    }
+  }
