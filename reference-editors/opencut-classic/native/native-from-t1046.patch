+/** 删除独立预览URL对应缓存，保留活动编辑器的其他图片。 */
+export function clearImageSourcesForUrls(urls: string[]) {
+  for (const [key, promise] of imageSourceCache) {
+    if (!urls.some((url) => key.startsWith(`${url}::`))) continue;
+    imageSourceCache.delete(key);
+    void promise
+      .then(({ source }) => {
+        imageSources.delete(source);
+        if (source instanceof HTMLImageElement) {
+          source.onload = null;
+          source.onerror = null;
+          source.removeAttribute("src");
+          source.remove();
+        } else {
+          source.width = 1;
+          source.height = 1;
+        }
+      })
+      .catch(() => {});
+  }
+}
 
