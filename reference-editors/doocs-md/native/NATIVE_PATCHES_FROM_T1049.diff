+/** 原生宿主资源由同文档 lease 装配，不修改 DOM 原型。 */
+export interface NativeDomHost {
+  root: HTMLElement
+  portal: HTMLElement
+  signal: AbortSignal
+  mode: 'light' | 'dark'
+  live: boolean
+  ready?: Promise<void>
+  readyResolve?: () => void
+  readyReject?: (error: unknown) => void
+  imageUrls: Map<string, string>
+  imageBlobs: Map<string, Blob>
+  jobs: Set<Promise<unknown>>
+  cleanups: Set<() => void>
+  importMedia: (file: File) => Promise<{ mediaId: string }>
+  onError: (message: string) => void
+}
+let active: NativeDomHost | undefined
+export function setNativeHost(host?: NativeDomHost) { active = host }
+export function getNativeHost() { return active }
+export function isNativeHost() { return !!active }
+export function nativeAlive(host = active) { return !host || host.live && !host.signal.aborted }
+export function nativeQuery<T extends Element = Element>(selector: string): T | null {
+  if (!active) return document.querySelector<T>(selector)
+  return nativeAlive(active) ? active.root.querySelector<T>(selector) ?? active.portal.querySelector<T>(selector) : null
+}
+export function nativeQueryAll<T extends Element = Element>(selector: string): NodeListOf<T> {
+  return active ? active.root.querySelectorAll<T>(nativeAlive(active) ? selector : ':not(*)') : document.querySelectorAll<T>(selector)
+}
+export function nativeById(id: string): HTMLElement | null {
+  return nativeQuery<HTMLElement>(`[id="${id.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"]`)
+}
+export function appendNativeStyle<T extends Node>(node: T): T {
+  if (!nativeAlive()) throw new Error('稿件已关闭')
+  return (active ? active.root : document.head).appendChild(node)
+}
+export function appendNativeTransient<T extends Node>(node: T): T {
+  if (!nativeAlive()) throw new Error('稿件已关闭')
+  return (active ? active.portal : document.body).appendChild(node)
+}
+export function nativePortal() { return active?.portal }
+export function ownsNativeFocus(event?: Event) {
+  if (!active) return true
+  if (!nativeAlive(active)) return false
+  const path = event?.composedPath() ?? []
+  const root = active.root.getRootNode() as Document | ShadowRoot
+  const focused = root.activeElement
+  return path.some(node => node instanceof Node && (active!.root.contains(node) || active!.portal.contains(node)))
+    || !!focused && (active.root.contains(focused) || active.portal.contains(focused))
+}
+/** Abort releases the lease; the original continuation must also check its captured host. */
+export function trackNativeJob<T>(host: NativeDomHost | undefined, job: Promise<T>): Promise<T> {
+  if (!host) return job
+  let abort!: () => void
+  const cancelled = new Promise<never>((_, reject) => {
+    abort = () => reject(new Error('稿件已关闭或操作已取消'))
+    if (!nativeAlive(host)) abort()
+    else host.signal.addEventListener('abort', abort, { once: true })
+  })
+  const result = Promise.race([job, cancelled])
+  host.jobs.add(result)
+  void result.finally(() => {
+    host.signal.removeEventListener('abort', abort)
+    host.jobs.delete(result)
+  }).catch(() => {})
+  return result
+}
+
+const MISSING_IMAGE = `data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="360" height="72"><rect width="360" height="72" fill="#f1f1f1"/><text x="16" y="42" font-size="14" fill="#555">图片未绑定作品素材</text></svg>')}`
+/** SEMANTIC_BOUNDARY_ALLOW: only resolve exact verified asset IDs; no content or creative choice. */
+export function resolveNativeImages(html: string): string {
+  const host = getNativeHost()
+  if (!host) return html
+  const registered = new Set(host.imageUrls.values())
+  // 只在图片槽保留明确 image MIME 的内嵌图，供原公式/图表使用。
+  const inlineImage = /^data:image\/(?:png|jpeg|gif|webp|avif|bmp|svg\+xml)(?:;[^,]*)?,/i
+  const resolve = (raw: string) => {
+    const match = /^creatoros-asset:([^:\s]+):([^:\s]+)$/.exec(raw)
+    return match ? host.imageUrls.get(`${match[1]}:${match[2]}`) ?? MISSING_IMAGE
+      : registered.has(raw) || inlineImage.test(raw) ? raw : MISSING_IMAGE
+  }
+
+  // template 的 HTML 解析器处理合法引号/换行/实体，且其内容在检查前保持惰性。
+  const template = host.root.ownerDocument.createElement('template')
+  template.innerHTML = html
+  // 图片候选全部退回同一已核验 img；保留 picture/source 结构及 media/type。
+  for (const source of template.content.querySelectorAll('picture source')) {
+    source.removeAttribute('srcset')
+    source.removeAttribute('src')
+  }
+  for (const image of template.content.querySelectorAll('img')) {
+    image.removeAttribute('srcset')
+    image.setAttribute('src', resolve(image.getAttribute('src') ?? ''))
+  }
+  for (const image of template.content.querySelectorAll('svg image')) {
+    image.removeAttribute('srcset')
+    if (image.hasAttribute('href')) image.setAttribute('href', resolve(image.getAttribute('href') ?? ''))
+    if (image.hasAttribute('xlink:href')) image.setAttributeNS('http://www.w3.org/1999/xlink', 'xlink:href', resolve(image.getAttribute('xlink:href') ?? ''))
+    if (!image.hasAttribute('href') && !image.hasAttribute('xlink:href')) image.setAttribute('href', MISSING_IMAGE)
+  }
+  return template.innerHTML
+}
