+import assert from 'node:assert/strict'
+import {readFileSync,readdirSync,lstatSync,readlinkSync,realpathSync} from 'node:fs'
+import {createHash} from 'node:crypto'
+import path from 'node:path'
+const [first,second]=process.argv.slice(2).map(value=>realpathSync(value))
+assert.ok(first&&second,'提供两个独立源码根目录')
+const sha=value=>createHash('sha256').update(value).digest('hex')
+const excluded=new Set(['node_modules','dist','dist-native','.git','.claude','.wxt','.cache','native-evidence','delivery','__pycache__'])
+function tree(root,source=false){
+ const files={}
+ function walk(directory){for(const name of readdirSync(directory).sort()){
+  if(source&&(excluded.has(name)||/\.(?:tsbuildinfo|log|DS_Store)$/.test(name)))continue
+  const file=path.join(directory,name),stat=lstatSync(file),key=path.relative(root,file)
+  if(stat.isSymbolicLink())files[key]=sha('symlink:'+readlinkSync(file))
+  else if(stat.isDirectory())walk(file)
+  else if(stat.isFile())files[key]=sha(readFileSync(file))
+ }}
+ walk(root);return files
+}
+function evidence(root){
+ const dist=path.join(root,'apps/web/dist-native'),files=tree(dist),source=tree(root,true)
+ const manifest=JSON.parse(readFileSync(path.join(dist,'SHA256.json'),'utf8')),graph=JSON.parse(readFileSync(path.join(dist,'native-build-graph.json'),'utf8'))
+ assert.equal(manifest.upstream.license,'WTFPL')
+ for(const [file,hash] of Object.entries(manifest.files))assert.equal(files[file],hash,file)
+ const resolved={}
+ for(const name of ['vite','vue','@tailwindcss/vite','@md/core','@md/shared'])resolved[name]=realpathSync(path.join(root,'apps/web/node_modules',name))
+ assert.equal(resolved['@md/core'],realpathSync(path.join(root,'packages/core')))
+ assert.equal(resolved['@md/shared'],realpathSync(path.join(root,'packages/shared')))
+ return {root,files,source,lockSha256:sha(readFileSync(path.join(root,'pnpm-lock.yaml'))),resolved,modules:graph.modules.length,dependencies:graph.dependencies.length}
+}
+const a=evidence(first),b=evidence(second)
+const mismatches=(x,y)=>[...new Set([...Object.keys(x),...Object.keys(y)])].sort().filter(key=>x[key]!==y[key])
