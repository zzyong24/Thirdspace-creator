{
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=25 <26"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @creatoros/backend exec tsx scripts/migrate.ts",
    "db:gen-baseline": "pnpm --filter @creatoros/backend exec tsx scripts/gen-baseline-migration.ts",
    "reconcile": "node orchestrator/process/reconcile.mjs",
    "boundary": "node orchestrator/process/boundary-scan.mjs",
    "pmem:sync": "node orchestrator/process/pmem.mjs sync"
  }
}
