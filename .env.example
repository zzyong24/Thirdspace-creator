# 配置化纯-LLM 默认 provider(纯-prompt 节点用)。真实值写进 .env.local(gitignored)。
# 留空则回落到内置默认(api.anthropic.com / claude-opus-4-8 / 需要 ANTHROPIC_API_KEY)。
CREATOROS_LLM_BASE_URL=https://api.minimaxi.com/anthropic
CREATOROS_LLM_API_FORMAT=anthropic
CREATOROS_LLM_MODEL=MiniMax-M3
CREATOROS_LLM_AUTH_STYLE=bearer
CREATOROS_LLM_SECRET_REF=env:MINIMAX_AUTH_TOKEN
# 真实密钥(只放 .env.local):
# MINIMAX_AUTH_TOKEN=sk-...

# [T-084a] 联网检索默认 provider(素材搜集 material.gather 前置真检索用;capability web.search)。
# 优先走设置页「联网搜索」卡的库存配置;这里是 env 兜底档。需 provider + key(model 选填:
# serpapi 用它当 engine,默认 google)。未配 → 素材来自模型记忆(卡片黄条 + 需核实徽标,诚实降级)。
# provider 首发:bocha(博查,中文优)/ tavily / serpapi。真实密钥只放 .env.local(gitignored)。
# CREATOROS_SEARCH_PROVIDER=bocha
# CREATOROS_SEARCH_MODEL=
# CREATOROS_SEARCH_BASE_URL=
# CREATOROS_SEARCH_SECRET_REF=env:CREATOROS_SEARCH_API_KEY
# CREATOROS_SEARCH_API_KEY=sk-...  # 只放 .env.local

# ─── T-147 P5 桌面激活授权(接 activation-manager 一机一码)───────────────────
# 只影响**桌面壳**(Tauri,CREATOROS_DESKTOP=1 由 Rust 运行时注入);web/dev 不触发激活门。
# 接入前须先在 activation-manager 后台(https://license.aitongban.cloud/admin)建 projectKey
# 对应项目并启用,否则所有激活/校验请求返 400「项目不存在」。详见 docs/desktop-activation-guide.md。
# CREATOROS_LICENSE_BASE_URL=https://license.aitongban.cloud   # 授权服务地址(默认即线上)
# CREATOROS_LICENSE_PROJECT_KEY=test                          # 项目标识(默认 test)
# CREATOROS_ACTIVATION_GRACE_DAYS=7                           # 离线宽限天数(在线校不到时的容忍窗)
# CREATOROS_MACHINE_ID=                                       # 桌面壳自动注入;手动测试可覆盖
# 测试激活码**绝不写进这里**——本地测试用 --code 参数或 CREATOROS_TEST_CODE(仅 .env.local):
# CREATOROS_TEST_CODE=xxxx  # 只放 .env.local(gitignored),绝不提交
