{
  "name": "@creatoros/contract",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "exports": {
    "./agent-workbench": {
      "types": "./src/internal/agent-workbench.ts",
      "default": "./src/internal/agent-workbench.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./execution-worker": {
      "types": "./src/internal/execution-worker.ts",
      "default": "./src/internal/execution-worker.ts"
    },
    "./embedding-io": {
      "types": "./src/internal/embedding-io.ts",
