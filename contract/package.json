    },
    "./timeout-policy": {
      "types": "./src/timeout-policy.ts",
      "default": "./src/timeout-policy.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.4.3"
