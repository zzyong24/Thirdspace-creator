{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "[T-147 P1] 桌面壳最小能力集。仅授予 core 默认 + shell 插件(为 spawn sidecar)。P2 会按 deny-all 收紧。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "opener:default",
    "shell:allow-kill",
    "updater:default",
    "process:default"
  ]
}
