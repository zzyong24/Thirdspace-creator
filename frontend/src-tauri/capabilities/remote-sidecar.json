{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-sidecar",
  "description": "[T-731] sidecar 远程页面只获得当前真实使用的授权判定命令与严格无参重启命令；不得直接获得 updater/process/opener/shell 插件能力。",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "allow-license-activate",
    "allow-license-check",
    "allow-entitlement-claim-start",
    "allow-entitlement-claim-poll",
    "allow-entitlement-claim-resume",
    "allow-license-last-decision",
    "allow-relaunch-app"
  ]
}
