{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CreatorOS",
  "mainBinaryName": "CreatorOS",
  "version": "1.2.0",
  "identifier": "cloud.aitongban.creatoros",
  "build": {
    "frontendDist": "./placeholder-dist",
    "beforeBuildCommand": "node scripts/desktop/build-sidecar.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/creatoros-server"
    ],
    "resources": [
      "sidecar.tar.gz",
      "THIRD_PARTY_NOTICES.md"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "dmg": {
        "background": "dmg/creatoros-install-background@2x.png",
        "windowPosition": {
          "x": 200,
          "y": 120
        },
        "windowSize": {
          "width": 800,
          "height": 500
        },
        "appPosition": {
          "x": 225,
          "y": 245
        },
        "applicationFolderPosition": {
          "x": 575,
          "y": 245
        }
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0MEI4MzE0NjgzN0IzMEQKUldRTnN6ZG9GSU1MTkdxOVJqLzcrTStCVFZxNEd2Z3V6ZitSQ3NqMFk5Wnk0REdLWi8yK2dsOHkK",
      "endpoints": []
    }
  }
}
