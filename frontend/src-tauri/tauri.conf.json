{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CreatorOS",
  "mainBinaryName": "CreatorOS",
  "version": "0.1.0",
  "identifier": "cloud.aitongban.creatoros",
  "build": {
    "frontendDist": "./placeholder-dist",
    "beforeBuildCommand": "node scripts/desktop/build-sidecar.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/creatoros-server"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {}
  },
  "plugins": {}
}
