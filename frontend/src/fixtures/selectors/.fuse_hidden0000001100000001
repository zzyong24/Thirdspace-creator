const DASHBOARD_METRICS: ReadonlyArray<MetricCard> = [
  { id: "m-active-projects", label: "进行中项目", value: "7", delta: "+1", trend: "up", tone: "positive" },
  { id: "m-publications", label: "已完成", value: "12", delta: "+1", trend: "up", tone: "positive" },
  { id: "m-views", label: "累计播放", value: "128.6w", delta: "+12%", trend: "up", tone: "positive" },
  { id: "m-assets", label: "素材库", value: "43.25", delta: "+1.2%", trend: "up", tone: "positive" },
  { id: "m-storage", label: "存储使用", value: "2.4w", delta: "-0.5%", trend: "down", tone: "warning" },
];

function buildDataOverview(): DataOverview {
  // The reference design renders the inner 2x2 grid using
  // 已发布 / 累计播放 / 素材库 / 存储使用 (4 of the 5 top-row metrics),
  // skipping 进行中项目. We pick the matching subset by id so the
  // dashboard selector is the single source of truth.
  const subsetIds = new Set([
    "m-publications",
    "m-views",
    "m-assets",
    "m-storage",
  ]);
  const metrics = DASHBOARD_METRICS.filter((metric) =>
    subsetIds.has(metric.id),
  );
  return {
    metrics,
    trend: [
      { label: "周一", value: 1840 },
      { label: "周二", value: 2210 },
      { label: "周三", value: 1980 },
      { label: "周四", value: 2740 },
      { label: "周五", value: 3120 },
      { label: "周六", value: 2960 },
      { label: "周日", value: 3380 },
    ],
  };
}

export function buildDashboardViewModel(): DashboardViewModel {
  const continueProject =
    listProjects().find((project) => project.status === "active") ?? listProjects()[0];

  const continueCreating = {
    heading: "继续创作",
    projectId: continueProject.id,
    projectTitle: continueProject.title,
    stage: continueProject.currentStage,
    progressPct: continueProject.progressPct,
    updatedAt: continueProject.updatedAt,
  } as const;

  const todos = canonicalDataset.tasks
    .filter((task) => task.status !== "done")
    .sort((a, b) => priorityOrder(a.priority) - priorityOrder(b.priority))
    .map((task) => {
      const project = canonicalDataset.projects.find((p) => p.id === task.projectId);
      return {
        id: task.id,
        title: task.title,
        projectId: task.projectId,
        projectTitle: project?.title ?? "",
        stage: task.stage,
        dueAt: task.dueAt,
        priority: task.priority,
        status: task.status,
      };
    });

  const recentPublications = canonicalDataset.publications
    .slice()
    .sort((a, b) => (b.publishedAt ?? "").localeCompare(a.publishedAt ?? ""))
    .map((publication) => {
      const metricViews = canonicalDataset.metricValues
        .filter((m) => m.dimensions["platform"] === publication.platform)
        .filter((m) => m.metricKey === "views")
        .reduce((sum, m) => sum + m.numericValue, 0);
      return {
        id: publication.id,
        title: canonicalDataset.contentOutputs.find((c) => c.id === publication.contentOutputId)?.title ?? "",
        platform: publication.platform,
        status: publication.status,
        views: metricViews,
        engagement: 0,
        publishedAt: publication.publishedAt ?? publication.updatedAt,
      };
    });

  return {
    scenario: "default",
    kind: "dashboard",
    metrics: DASHBOARD_METRICS,
    continueCreating,
    todos,
    trendingTopics: [
      { id: "topic-1", title: "AI Native Browser 深度解析", heat: 92, trend: "up" },
      { id: "topic-2", title: "本地优先栈", heat: 78, trend: "up" },
      { id: "topic-3", title: "代理任务设计", heat: 66, trend: "flat" },
    ],
    recentPublications,
    dataOverview: buildDataOverview(),
    suggestions: [
      {
        id: "sg-1",
        title: "把研究阶段结论补充到脚本",
        description: "研究产物《竞品浏览器对比》尚未被脚本引用。",
        category: "script",
      },
      {
        id: "sg-2",
        title: "上传开场 B-Roll",
        description: "开场 15 秒还缺 1 段视频素材。",
        category: "production",
      },
    ],
    assistantPrompt: "今天想先做点什么？",
    loading: false,
    error: null,
  };
}

function priorityOrder(priority: number): number {
  return priority;
}
