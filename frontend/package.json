    "visual:diff": "node scripts/visual/diff.mjs",
    "fixtures:export": "tsx --tsconfig tsconfig.json scripts/fixtures/export-canonical-json.mts",
    "video:regression:t712": "node --conditions=react-server --import tsx scripts/t712-video-regression-loop.ts",
    "verify:built-in-course": "node scripts/verify-built-in-course.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "tauri": "tauri",
    "desktop:build-sidecar": "node scripts/desktop/build-sidecar.mjs",
    "desktop:dev": "node scripts/desktop/build-sidecar.mjs && tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:build": "tauri build",
    "desktop:package": "node scripts/desktop/package.mjs",
    "desktop:package-local": "node scripts/desktop/package-local.mjs",
    "desktop:package-channel": "node scripts/desktop/package-channel.mjs",
