  "scripts": {
    "dev": "next dev",
    "prebuild": "node ../ai-worker/scripts/build.mjs && node scripts/verify-built-in-course.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "PLAYWRIGHT_TEST_UPDATE_SNAPSHOTS=never playwright test --project=visual --pass-with-no-tests",
