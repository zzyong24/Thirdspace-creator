{
  "name": "creatoros-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "PLAYWRIGHT_TEST_UPDATE_SNAPSHOTS=never playwright test --project=visual --pass-with-no-tests",
    "test:a11y": "playwright test --project=accessibility --pass-with-no-tests",
    "visual:verify-shas": "node scripts/visual/verify-shas.mjs",
    "visual:install-baselines": "node scripts/visual/install-baselines.mjs",
    "visual:capture-current": "node scripts/visual/capture-current.mjs",
    "visual:diff": "node scripts/visual/diff.mjs",
    "fixtures:export": "tsx --tsconfig tsconfig.json scripts/fixtures/export-canonical-json.mts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.6",
    "@anthropic-ai/sdk": "^0.105.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@creatoros/ai-worker": "workspace:*",
    "@creatoros/backend": "workspace:*",
    "@creatoros/contract": "workspace:*",
    "@fontsource-variable/noto-sans-sc": "5.2.10",
    "@tiptap/pm": "3.27.1",
    "@tiptap/react": "3.27.1",
    "@tiptap/starter-kit": "3.27.1",
    "ai": "^7.0.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "exceljs": "^4.4.0",
    "lucide-react": "1.18.0",
    "next": "16.2.9",
    "node-cron": "^4.5.0",
    "radix-ui": "1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "4.11.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.43",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "jsdom": "29.1.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "4.3.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}
