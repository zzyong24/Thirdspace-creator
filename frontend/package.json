    "desktop:obfuscate": "node scripts/desktop/obfuscate.mjs",
    "desktop:release": "node scripts/desktop/release.mjs",
    "desktop:codesign": "node scripts/desktop/codesign.mjs",
    "desktop:notarize": "node scripts/desktop/notarize.mjs",
    "desktop:updater-keygen": "node scripts/desktop/updater-keygen.mjs",
    "desktop:master-key": "node scripts/desktop/master-key.mjs",
    "desktop:activation": "node scripts/desktop/activation.mjs",
    "desktop:prompt-bundle": "node scripts/desktop/prompt-bundle.mjs",
    "predev": "node ../ai-worker/scripts/build.mjs",
    "build:noterelay": "node scripts/build-noterelay.mjs"
  },
